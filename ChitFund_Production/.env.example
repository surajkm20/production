# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL=postgresql://user:password@host:5432/chitfund

# JWT secrets — use long random strings (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_random_secret

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Server
PORT=3000
NODE_ENV=development

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SMS provider (MSG91)
MSG91_AUTH_KEY=replace_with_msg91_key
MSG91_SENDER_ID=CHITFD
MSG91_TEMPLATE_ID=replace_with_template_id

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_CONTACT_EMAIL=your@email.com